Unzero <- function(m) {
    for (i in 1:dim(m)[1]) {
        found <- FALSE
        for (j in 1:dim(m)[2]) {
            found = found || m[i,j] != 0
        }
        if (!found) {
#           print (i)
            m[i,i] = -1
        }
    }
    m
}
